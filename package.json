{
  "name": "courier",
  "version": "0.1.1",
  "description": "Local-first, air-gapped, git-native API testing tool with AI Copilot",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "node server/index.js",
    "dev:client": "vite",
    "build": "vite build",
    "start": "node server/index.js",
    "electron": "electron .",
    "dist": "npm run build && electron-builder --win portable",
    "dist:zip": "npm run build && electron-builder --win zip",
    "pack": "npm run build && electron-builder --win nsis",
    "cli": "node server/cli.js",
    "test": "node --test server/tests/*.test.js"
  },
  "keywords": [
    "api-client",
    "postman-alternative",
    "bruno-alternative",
    "offline-first",
    "local-first",
    "ai-copilot",
    "test-runner"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.7.9",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "electron": "^31.7.4",
    "electron-builder": "^24.13.1",
    "lucide-react": "^0.475.0",
    "postcss": "^8.5.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  },
  "build": {
    "appId": "com.courier.app",
    "productName": "Courier",
    "forceCodeSigning": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "server/**/*",
      "courier-data/**/*",
      "electron/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/courier-icon.ico",
      "target": [
        "portable"
      ],
      "sign": null,
      "signAndEditExecutable": false
    }
  }
}

